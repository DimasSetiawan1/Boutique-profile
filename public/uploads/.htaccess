# ==============================================================================
# ANTI-WEBSHELL & ANTI-BACKDOOR SCRIPT EXECUTION LOCKDOWN
# ==============================================================================

# Block execution of all executable scripts and shell files
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|py|sh|bash|exe|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP engine in this folder
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Disable CGI execution and directory listing
Options -Indexes -ExecCGI
